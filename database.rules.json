// Reglas de Realtime Database para el control remoto (F8).
//
// ESTADO: reglas de F8.3 — cubren lo que F8.2 + F8.3 necesitan para ser
// seguros (creación de sesión, unión de un único remoto, comandos
// discretos, snapshot de reproducción), NO son las definitivas de F8.6.
//
// La escritura en /sessions/$sessionId se permite en cuatro casos, y en
// ningún otro:
//   1) CREACIÓN: la sesión no existe todavía, y quien escribe se declara a
//      sí mismo como hostUid (no puede crear una sesión a nombre de otro
//      uid), sin remoto asignado.
//   2) HOST: el hostUid de la sesión ya existente coincide con quien
//      escribe — el host puede reescribir su propia sesión libremente
//      (cerrarla, publicar `playback`, etc.).
//   3) UN REMOTO NUEVO SE UNE: la sesión existe, no está finalizada, no
//      expiró, y todavía no tiene remoteUid — quien escribe puede
//      registrarse a sí mismo como remoteUid, pero SOLO si hostUid/
//      createdAt/expiresAt/scriptTitle/playback quedan exactamente iguales
//      (no puede tocar nada del host, "convertirse" en host, ni inyectar un
//      snapshot de reproducción falso).
//   4) EL REMOTO YA EMPAREJADO SE ACTUALIZA: quien escribe ya es el
//      remoteUid registrado — puede actualizar remoteConnected/status (para
//      reflejar reconexión/desconexión vía onDisconnect) y escribir
//      `command` (F8.3), con las mismas restricciones de no tocar hostUid/
//      createdAt/expiresAt/scriptTitle/playback.
//
// Como ambas ramas cascadean permiso sobre TODO el subárbol de la sesión
// (así es como RTDB evalúa un `set()`/transacción sobre un nodo
// intermedio), fijar esos campos como "deben quedar iguales" en las ramas 3
// y 4 es lo que impide que el remoto los escriba — una regla propia en el
// hijo no serviría de nada, porque el permiso ya concedido en el nodo padre
// ($sessionId) se aplica igual hacia abajo.
//
// HALLAZGO IMPORTANTE (probado contra el emulador): `newData.child('playback').val()
// === data.child('playback').val()` NO es una comparación confiable cuando
// `playback` es un objeto (tiene varios campos) — el lenguaje de reglas de
// RTDB solo garantiza `===` entre valores primitivos. Con esa comparación,
// las ramas 3/4 funcionaban mientras `playback` todavía era `null`, pero
// EMPEZABAN A RECHAZAR TODO (incluidos los comandos legítimos del remoto)
// en cuanto el host publicaba el primer snapshot de reproducción. La
// corrección es comparar cada campo hoja de `playback` por separado (todos
// primitivos), nunca el objeto completo.
//
// La lectura exige solamente estar autenticado (Anonymous Auth). Limitar la
// lectura de una sesión a exactamente su hostUid/remoteUid queda pendiente
// para F8.6 — hoy cualquier usuario autenticado que conozca (o adivine) un
// sessionId válido podría leer hostUid/remoteUid/scriptTitle/command/
// playback de esa sesión. Como el sessionId es un UUID aleatorio de 122
// bits, adivinarlo no es viable en la práctica, y no se expone contenido
// del guion, posición en píxeles ni datos personales — pero la separación
// de lectura por rol es trabajo real pendiente, no una omisión aceptada
// como definitiva.
{
  "rules": {
    "sessions": {
      "$sessionId": {
        ".read": "auth != null",

        ".write": "auth != null && (
          (!data.exists() && newData.child('hostUid').val() === auth.uid && newData.child('remoteUid').val() === null) ||
          (data.exists() && data.child('hostUid').val() === auth.uid) ||
          (data.exists() && data.child('status').val() !== 'ended' && data.child('expiresAt').val() > now &&
           data.child('remoteUid').val() === null &&
           newData.child('remoteUid').val() === auth.uid &&
           newData.child('hostUid').val() === data.child('hostUid').val() &&
           newData.child('createdAt').val() === data.child('createdAt').val() &&
           newData.child('expiresAt').val() === data.child('expiresAt').val() &&
           newData.child('scriptTitle').val() === data.child('scriptTitle').val() &&
           newData.child('playback').child('engineStatus').val() === data.child('playback').child('engineStatus').val() &&
           newData.child('playback').child('progress').val() === data.child('playback').child('progress').val() &&
           newData.child('playback').child('wpm').val() === data.child('playback').child('wpm').val() &&
           newData.child('playback').child('pausedByMarker').val() === data.child('playback').child('pausedByMarker').val() &&
           newData.child('playback').child('updatedAt').val() === data.child('playback').child('updatedAt').val()) ||
          (data.exists() && data.child('remoteUid').val() === auth.uid &&
           newData.child('remoteUid').val() === auth.uid &&
           newData.child('hostUid').val() === data.child('hostUid').val() &&
           newData.child('createdAt').val() === data.child('createdAt').val() &&
           newData.child('expiresAt').val() === data.child('expiresAt').val() &&
           newData.child('scriptTitle').val() === data.child('scriptTitle').val() &&
           newData.child('playback').child('engineStatus').val() === data.child('playback').child('engineStatus').val() &&
           newData.child('playback').child('progress').val() === data.child('playback').child('progress').val() &&
           newData.child('playback').child('wpm').val() === data.child('playback').child('wpm').val() &&
           newData.child('playback').child('pausedByMarker').val() === data.child('playback').child('pausedByMarker').val() &&
           newData.child('playback').child('updatedAt').val() === data.child('playback').child('updatedAt').val())
        )"
      }
    },
    ".read": false,
    ".write": false
  }
}
