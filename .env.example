# Variables de entorno para la infraestructura de control remoto (F8).
# Copiar este archivo a .env.local (que ya está ignorado por git vía
# *.local en .gitignore) y completar con los valores reales del proyecto
# Firebase. Mientras falte cualquiera de estas 7 variables, el control
# remoto queda deshabilitado y el resto de la app (Mis guiones, Editor,
# Teleprompter, Glass Test, perfiles) sigue funcionando con normalidad.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_DATABASE_URL=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
